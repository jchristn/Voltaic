<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>2.3.0</Version>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationIcon>logo.ico</ApplicationIcon>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<!-- Every public type and member must be documented. -->
		<WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
		<!-- Trimming and Native AOT: the analyzers run on every build and their warnings are errors. -->
		<IsAotCompatible>true</IsAotCompatible>
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2067;IL2070;IL2072;IL2075;IL2087;IL2090;IL2091;IL3050;IL3051</WarningsAsErrors>
		<DocumentationFile>Voltaic.xml</DocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>Voltaic</Title>
		<Authors>jchristn</Authors>
		<Description>Voltaic is an open source, dependency-light JSON-RPC 2.0, MCP, and A2A client/server library.</Description>
		<Copyright>(c)2025 Joel Christner</Copyright>
		<PackageProjectUrl>https://github.com/jchristn/Voltaic</PackageProjectUrl>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/jchristn/Voltaic</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>json;rpc;aot;nativeaot;trimming;websocket;websockets;http;stdio;mcp;a2a;agent2agent;agent;client;server;tcp;grpc;protobuf;ai;llm;model;context;protocol;resources;prompts;tools;streamable-http;sse;schema</PackageTags>
		<PackageReleaseNotes>v2.3.0: Native AOT and trimming support (IsAotCompatible on net8.0 and net10.0). Voltaic serializes from source-generated metadata; applications add a JsonSerializerContext for their own types with VoltaicJson.AddTypeInfoResolver. Without AOT nothing changes and JSON output is identical. Watson 7.3.0. See CHANGELOG.md.</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="logo.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.36.2" />
		<PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
		<PackageReference Include="Watson" Version="7.3.0" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="A2A\Protos\a2a.proto" GrpcServices="None" Access="Internal" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\assets\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
