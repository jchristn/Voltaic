<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>2.1.7</Version>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationIcon>logo.ico</ApplicationIcon>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<!-- Every public type and member must be documented. -->
		<WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
		<DocumentationFile>Voltaic.xml</DocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>Voltaic</Title>
		<Authors>jchristn</Authors>
		<Description>Voltaic is an open source, dependency-light JSON-RPC 2.0, MCP, and A2A client/server library.</Description>
		<Copyright>(c)2025 Joel Christner</Copyright>
		<PackageProjectUrl>https://github.com/jchristn/Voltaic</PackageProjectUrl>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/jchristn/Voltaic</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>json;rpc;websocket;websockets;http;stdio;mcp;a2a;agent2agent;agent;client;server;tcp;grpc;protobuf;ai;llm;model;context;protocol;resources;prompts;tools;streamable-http;sse;schema</PackageTags>
		<PackageReleaseNotes>v2.1.7: Every MCP MUST and SHOULD requirement met on every revision and transport. See CHANGELOG.md and COMPATIBILITY.md.</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="logo.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.35.1" />
		<PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="All" />
		<PackageReference Include="Watson" Version="7.1.0" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="A2A\Protos\a2a.proto" GrpcServices="None" Access="Internal" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\assets\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
